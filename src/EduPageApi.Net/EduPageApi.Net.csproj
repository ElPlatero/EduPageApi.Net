<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>EduPageApi.Net</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <RootNamespace>EduPageApi</RootNamespace>
    <Description>An independent fluent .NET client for authorized EduPage data.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ElPlatero/EduPageApi.Net</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
